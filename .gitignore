# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml
.idea/workspace.xml

# Keystore files
*.jks

# --- trading research (milestone 1) ---
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Immutable local data snapshots live OUTSIDE git (they are frozen local
# data, recreated via `python -m data.refresh`). The one exception is the
# small committed fixture snapshot so tests run from a fresh clone.
data/snapshots/*
!data/snapshots/fixture/
